{
    "name": "bluefairy/api-gateway",
    "description": "REST response caching, rate limiting and outbound webhooks for WordPress. No third-party SDKs: every HTTP call goes through wp_remote_post.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.0.3",
    "keywords": ["wordpress", "rest-api", "cache", "rate-limit", "webhooks", "no-third-party-sdks"],
    "authors": [
        {
            "name": "Blue Fairy Development",
            "homepage": "https://bluefairydevelopment.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "BlueFairy\\ApiGateway\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFairy\\ApiGateway\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
