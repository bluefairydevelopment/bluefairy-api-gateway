# Keep development files out of the release zip (git archive) and the WP.org tag.
/tests            export-ignore
/vendor           export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/phpcs.xml.dist   export-ignore
/phpstan.neon     export-ignore
/phpstan-bootstrap.php export-ignore
/phpunit.xml.dist export-ignore
/composer.lock    export-ignore
/.phpunit.cache   export-ignore
/docs/screenshots export-ignore
/composer.json    export-ignore
/docs/MARKETING.txt export-ignore
/docs/COMPARISON.md export-ignore
# FEATURES.md stays in the repo root — the features-guide generator
# (wp-testkit capture/generate-ApiGateway-guide.js) reads it from here — but
# does not ship: Plugin Check warns on unexpected markdown in the plugin root.
# Its content reaches users as docs/ApiGatewayFeaturesGuide.pdf, which ships.
/FEATURES.md      export-ignore
# WordPress.org listing assets (banners, icons, screenshots) go to the SVN
# assets/ directory, never into the plugin zip.
/wp-org-assets    export-ignore

# Only the features guide PDF ships from docs/ (2026-10-28). `git archive`
# reads these, not .distignore; the later -export-ignore wins for the guide.
/docs/*                     export-ignore
/docs/*FeaturesGuide.pdf    -export-ignore
